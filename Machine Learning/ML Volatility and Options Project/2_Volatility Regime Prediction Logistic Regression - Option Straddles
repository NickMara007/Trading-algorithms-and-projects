def call_price(S, K, r, T, sigma):
    if T <= 0:
        return max(S - K, 0)
    
    d1 = (np.log(S/K) + (r+(sigma**2/2)*T)) / (sigma*np.sqrt(T))
    d2 = d1 - sigma*np.sqrt(T)

    C = S*norm.cdf(d1) - K*np.exp(-r*T)*norm.cdf(d2)

    return C

def put_price(S, K, r, T, sigma):
    if T <= 0:
        return max(K - S, 0)

    d1 = (np.log(S/K) + (r+(sigma**2/2)*T)) / (sigma*np.sqrt(T))
    d2 = d1 - sigma*np.sqrt(T)

    P = -S*norm.cdf(-d1) + K*np.exp(-r*T)*norm.cdf(-d2)

    return P


def run_straddle_strategy(test, regime_pred, TP, SL, timeout):

    prices = test['Close'].values
    vol = test['20_day_volatility'].values * np.sqrt(252)
    dates = test.index

    num_trades = 0
    num_wins = 0
    trade_results = {}

    r = 0.02
    initial_capital = 10000
    capital = initial_capital

    equity_curve = []
    strategy_gains = np.ones(len(test))
    in_position = False

    option_value = 0
    K = 0
    T_total = 30/252 # 30 day expiry
    T_remaining = T_total
    T_timeout = T_total - timeout/252

    for i in range(1,len(test)):

        regime = regime_pred[i]
        price = prices[i]
        vol_current = vol[i]
        date = dates[i]

        if regime==1 and in_position == False:

            T_remaining = T_total
            entry_date = date
            entry_price = price
            K = np.round(price*2)/2

            call = call_price(price, K, r, T_remaining, vol_current)
            put = put_price(price, K, r, T_remaining, vol_current)

            option_value = call + put           

            in_position = True

        elif in_position:
            T_remaining -= 1/252

            call = call_price(price, K, r, T_remaining, vol_current)
            put = put_price(price, K, r, T_remaining, vol_current)
            
            option_value_new = call + put
            gain = 100*(option_value_new - option_value)/option_value
            strategy_gains[i] = 1 + gain/100

            if gain>=TP or gain<=-SL or T_remaining<=T_timeout or regime==0:
                exit_date = date
                exit_price = price

                num_trades += 1
                if gain>0: num_wins+=1

                trade_results[num_trades] = {
                    "Entry Date": entry_date,
                    #"Exit Date": exit_date,
                    "Stock Entry Price": entry_price,
                    "Stock Exit Price": exit_price,
                    "Strike": K,
                    "Vol": vol_current,
                    "Options Entry": option_value,
                    "Options Exit": option_value_new,
                    "Call":call,
                    "Put":put,
                    "Gain %": gain
                }

                in_position = False

    equity_curve = (np.cumprod(strategy_gains) - 1)*100
    
    final_gain = equity_curve[-1]
    win_rate = np.round(100*num_wins/num_trades,2)

    strategy_metrics = {
        "Number of Trades": num_trades,
        "Win Rate %": win_rate,
        "Total Gain": final_gain
    }            

    return equity_curve, trade_results, strategy_metrics


